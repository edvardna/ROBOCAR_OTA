bool parseVersionFromTag(String tag, String& out) {
  tag.trim();
  if (tag.length() == 0) return false;
  if (tag[0] == 'v' || tag[0] == 'V') tag.remove(0, 1);
  out = tag;
  return true;
}

void checkForOTA() {
  // runtime disable
  if (!OTA_ENABLED) {
    if (otaLine != "OTA  -> disabled") {
      otaLine = "OTA  -> disabled";
      updateOLED();
    }
    return;
  }

  if (!WiFi.isConnected()) return;
  if (millis() - lastUpdateCheck < updateCheckInterval) return;
  lastUpdateCheck = millis();

  otaLine = "OTA  -> checking";
  Serial.println("\n===== PRIVATE OTA CHECK =====");
  updateOLED();

  // 1) latest release JSON
  WiFiClientSecure net;
  net.setInsecure();

  HTTPClient http;
  String apiUrl = "https://api.github.com/repos/" + String(github_owner) + "/" + String(github_repo) + "/releases/latest";

  Serial.println("Requesting release...");
  if (!http.begin(net, apiUrl)) {
    Serial.println("OTA -> http.begin FAILED");
    otaLine = "OTA  -> begin fail";
    updateOLED();
    return;
  }

  http.setUserAgent("ESP32-OTA-Client");
  http.addHeader("Authorization", "token " + String(github_pat));
  http.addHeader("Accept", "application/vnd.github.v3+json");

  int code = http.GET();
  Serial.print("Release HTTP: ");
  Serial.println(code);

  if (code != HTTP_CODE_OK) {
    Serial.println("OTA -> Release fetch FAILED");
    Serial.println(http.getString());
    http.end();
    otaLine = "OTA  -> rel fail";
    updateOLED();
    return;
  }

  StaticJsonDocument<8192> doc;
  DeserializationError jerr = deserializeJson(doc, http.getStream());
  http.end();
  if (jerr) {
    Serial.print("OTA -> JSON parse error: ");
    Serial.println(jerr.c_str());
    otaLine = "OTA  -> json fail";
    updateOLED();
    return;
  }

  String latest;
  if (!parseVersionFromTag(doc["tag_name"].as<String>(), latest)) {
    Serial.println("OTA -> missing tag_name");
    otaLine = "OTA  -> no tag";
    updateOLED();
    return;
  }

  Serial.print("Latest: ");
  Serial.println(latest);
  Serial.print("Current: ");
  Serial.println(currentFirmwareVersion);

  if (latest == String(currentFirmwareVersion)) {
    Serial.println("OTA -> Up to date");
    otaLine = "OTA  -> up-to-date";
    updateOLED();
    return;
  }

  Serial.println("NEW VERSION DETECTED");
  otaLine = "OTA  -> new ver";
  updateOLED();

  // 2) find asset id
  String assetId = "";
  for (JsonObject a : doc["assets"].as<JsonArray>()) {
    String nm = a["name"].as<String>();
    if (nm == String(firmware_asset_name)) {
      assetId = a["id"].as<String>();
      break;
    }
  }

  if (assetId.length() == 0) {
    Serial.println("OTA -> asset not found");
    otaLine = "OTA  -> no asset";
    updateOLED();
    return;
  }

  String fwUrl = "https://api.github.com/repos/" + String(github_owner) + "/" + String(github_repo) + "/releases/assets/" + assetId;

  // 3) download asset
  Serial.println("Downloading firmware...");
  otaLine = "OTA  -> downloading";
  updateOLED();

  WiFiClientSecure fwClient;
  fwClient.setInsecure();

  HTTPClient fw;
  fw.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS);
  fw.setUserAgent("ESP32-OTA-Client");

  if (!fw.begin(fwClient, fwUrl)) {
    Serial.println("OTA -> fw.begin FAILED");
    otaLine = "OTA  -> fw begin fail";
    updateOLED();
    return;
  }

  fw.addHeader("Authorization", "token " + String(github_pat));
  fw.addHeader("Accept", "application/octet-stream");

  int fwCode = fw.GET();
  Serial.print("Firmware HTTP: ");
  Serial.println(fwCode);

  if (fwCode != HTTP_CODE_OK) {
    Serial.println("Firmware download FAILED");
    Serial.println(fw.getString());
    fw.end();
    otaLine = "OTA  -> fw  fail";
    updateOLED();
    return;
  }

  int contentLength = fw.getSize();
  if (contentLength <= 0) {
    Serial.println("OTA -> Invalid content length");
    fw.end();
    otaLine = "OTA  -> bad len";
    updateOLED();
    return;
  }

  // 4) flash
  Serial.println("Flashing...");
  otaLine = "OTA  -> flashing";
  updateOLED();

  if (!Update.begin(contentLength)) {
    Serial.print("Update.begin failed: ");
    Serial.println(Update.errorString());
    fw.end();
    otaLine = "OTA  -> no space";
    updateOLED();
    return;
  }

  WiFiClient* stream = fw.getStreamPtr();
  uint8_t buff[1024];
  size_t totalWritten = 0;
  int lastPct = -1;

  while (totalWritten < (size_t)contentLength) {
    int avail = stream->available();
    if (avail > 0) {
      int rd = stream->read(buff, (size_t)min(avail, (int)sizeof(buff)));
      if (rd < 0) {
        Serial.println("OTA -> stream read error");
        Update.abort();
        fw.end();
        otaLine = "OTA  -> read err";
        updateOLED();
        return;
      }

      size_t wr = Update.write(buff, rd);
      if (wr != (size_t)rd) {
        Serial.print("OTA -> write error: ");
        Serial.println(Update.errorString());
        Update.abort();
        fw.end();
        otaLine = "OTA  -> write err";
        updateOLED();
        return;
      }

      totalWritten += wr;
      int pct = (int)((totalWritten * 100UL) / (unsigned long)contentLength);
      if (pct != lastPct && (pct % 5 == 0 || pct == 100)) {
        Serial.print("Progress: ");
        Serial.print(pct);
        Serial.println("%");
        lastPct = pct;
      }
    }
    delay(1);
  }

  if (!Update.end()) {
    Serial.print("OTA -> Update.end failed: ");
    Serial.println(Update.errorString());
    fw.end();
    otaLine = "OTA  -> end fail";
    updateOLED();
    return;
  }

  if (!Update.isFinished()) {
    Serial.println("OTA -> not finished");
    fw.end();
    otaLine = "OTA  -> not fin";
    updateOLED();
    return;
  }

  fw.end();
  Serial.println("OTA SUCCESS! Rebooting...");
  otaLine = "OTA  -> success";
  updateOLED();
  delay(800);
  ESP.restart();
}

// =====================================================
// ================= SETUP / LOOP ======================
// =====================================================
void setup() {
  Serial.begin(115200);
  delay(200);

  bootLine = "BOOT -> done";
  wifiLine = "WIFI -> connecting";
  mqttLine = "MQTT -> waiting";
  otaLine  = "OTA  -> idle";

  // UART from UNO
  Serial1.begin(9600, SERIAL_8N1, ESP_RX, ESP_TX);
  Serial1.setTimeout(20);
  Serial.println("UART -> started RX=24 TX=23");

  // Motors
  pinMode(FL_IN1, OUTPUT); pinMode(FL_IN2, OUTPUT);
  pinMode(FR_IN1, OUTPUT); pinMode(FR_IN2, OUTPUT);
  pinMode(RL_IN1, OUTPUT); pinMode(RL_IN2, OUTPUT);
  pinMode(RR_IN1, OUTPUT); pinMode(RR_IN2, OUTPUT);
  stopAll();

  // OLED
  Wire.begin(OLED_SDA, OLED_SCL);
  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println("OLED -> init FAIL (addr 0x3C?)");
  } else {
    display.clearDisplay();
    display.display();
  }

  // WiFi
  Serial.println("WIFI -> connecting...");
  WiFi.begin(ssid, password);
  unsigned long t0 = millis();
  while (WiFi.status() != WL_CONNECTED) {
    delay(250);
    Serial.print(".");
    if (millis() - t0 > 20000) break;
  }

  if (WiFi.status() == WL_CONNECTED) {
    wifiLine = "WIFI -> IP " + WiFi.localIP().toString();
    Serial.println("\nWIFI -> connected");
    Serial.println(WiFi.localIP());
  } else {
    wifiLine = "WIFI -> failed";
    Serial.println("\nWIFI -> FAILED");
  }

  // MQTT TLS
  espClient.setInsecure();
  client.setServer(mqtt_server, mqtt_port);
  client.setCallback(mqttCallback);

  // Web routes
  server.on("/", handleRoot);
  server.on("/status", handleStatus);
  server.on("/toggle", handleToggle);
  server.on("/maze_toggle", handleMazeToggle);
  server.onNotFound([]() {
    if (server.uri().startsWith("/move/")) { handleMove(); return; }
    server.send(404, "text/plain", "Not found");
  });
  server.begin();
  Serial.println("WEB -> started");

  lastControlMsg = millis();

  updateOLED();

  tryConnectMQTT();

  lastUpdateCheck = millis() - updateCheckInterval + 8000;
}

void loop() {
  // Web
  server.handleClient();

  // MQTT
  tryConnectMQTT();
  if (client.connected()) client.loop();

  // Detect MQTT disconnect -> stop motors (safety)
  bool nowConnected = client.connected();
  if (wasMqttConnected && !nowConnected) {
    Serial.println("MQTT -> disconnected, stopping motors");
    motorEnabled = false;
    currentMove = "STOP";
    stopAll();
    updateOLED();
    publishStatusOnce();
  }
  wasMqttConnected = nowConnected;

  // UART read
  while (Serial1.available()) {
    String line = Serial1.readStringUntil('\n');
    if (line.length()) handleUartLine(line);
  }

  // MAZE MODE
  if (mazeMode) {
    runMazeSolver();
   }

  // SAFETY: if enabled and no recent control msg -> STOP (watchdog)
  // (disabled during mazeMode because maze keeps lastControlMsg fresh)
  if (!mazeMode && motorEnabled && (millis() - lastControlMsg > controlTimeout)) {
    if (currentMove != "STOP") {
      currentMove = "STOP";
      applyMove();
      updateOLED();
      publishStatusOnce();
    }
  }

  // OTA (periodic)
  checkForOTA();

  // Keep OLED fresh
  static unsigned long lastOled = 0;
  if (millis() - lastOled > 1000) {
    lastOled = millis();
    updateOLED();
  }
}
