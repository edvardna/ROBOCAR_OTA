void publishStatusOnce() {
  if (!client.connected()) return;

  StaticJsonDocument<320> st;
  st["version"] = currentFirmwareVersion;
  st["enabled"] = motorEnabled ? "ENABLED" : "DISABLED";
  st["move"]    = motorEnabled ? currentMove : "DISABLED";
  st["ip"]      = WiFi.isConnected() ? WiFi.localIP().toString() : String("-");
  st["mode"]    = mazeMode ? "MAZE" : "MANUAL";

  String out;
  serializeJson(st, out);

  client.publish(topic_status, out.c_str(), true); // retained
}

// =====================================================
// =============== PRECISE 90° ROTATION ================
// =====================================================
void rotate90Left() {
  if (!motorEnabled) { stopAll(); return; }

  // CCW pattern
  setMotorPins(FL_IN1, FL_IN2, -1);
  setMotorPins(FR_IN1, FR_IN2, +1);
  setMotorPins(RL_IN1, RL_IN2, -1);
  setMotorPins(RR_IN1, RR_IN2, +1);

  delay(ROTATE_90_TIME_MS);

  stopAll();
  currentMove = "STOP";
  updateOLED();
  publishStatusOnce();
}

void rotate90Right() {
  if (!motorEnabled) { stopAll(); return; }

  // CW pattern
  setMotorPins(FL_IN1, FL_IN2, +1);
  setMotorPins(FR_IN1, FR_IN2, -1);
  setMotorPins(RL_IN1, RL_IN2, +1);
  setMotorPins(RR_IN1, RR_IN2, -1);

  delay(ROTATE_90_TIME_MS);

  stopAll();
  currentMove = "STOP";
  updateOLED();
  publishStatusOnce();
}

// =====================================================
// ================= MOVE APPLY ========================
// =====================================================
void applyMove() {
  if (!motorEnabled) { stopAll(); return; }

  if (currentMove == "FORWARD") {
    setMotorPins(FL_IN1, FL_IN2, +1);
    setMotorPins(FR_IN1, FR_IN2, +1);
    setMotorPins(RL_IN1, RL_IN2, +1);
    setMotorPins(RR_IN1, RR_IN2, +1);

  } else if (currentMove == "BACKWARD") {
    setMotorPins(FL_IN1, FL_IN2, -1);
    setMotorPins(FR_IN1, FR_IN2, -1);
    setMotorPins(RL_IN1, RL_IN2, -1);
    setMotorPins(RR_IN1, RR_IN2, -1);

  } else if (currentMove == "LEFT") { // strafe left (manual only)
    setMotorPins(FL_IN1, FL_IN2, -1);
    setMotorPins(FR_IN1, FR_IN2, +1);
    setMotorPins(RL_IN1, RL_IN2, +1);
    setMotorPins(RR_IN1, RR_IN2, -1);

  } else if (currentMove == "RIGHT") { // strafe right (manual only)
    setMotorPins(FL_IN1, FL_IN2, +1);
    setMotorPins(FR_IN1, FR_IN2, -1);
    setMotorPins(RL_IN1, RL_IN2, -1);
    setMotorPins(RR_IN1, RR_IN2, +1);

  } else if (currentMove == "ROTATE_LEFT") {
    rotate90Left();

  } else if (currentMove == "ROTATE_RIGHT") {
    rotate90Right();

  } else { // STOP
    stopAll();
  }
}

// =====================================================
// ================= MAZE MODE =========================
// =====================================================
inline int safeDist(int d) { return (d < 0) ? 999 : d; }

void mazeSetMoveSafe(const String& mv) {
  unsigned long now = millis();
  if (now < mazeNextMoveAllowed) return;

  currentMove = mv;

  applyMove();
  updateOLED();
  publishStatusOnce();

  mazeNextMoveAllowed = now + MAZE_CHANGE_PAUSE_MS;
}

void mazeStepMove(const String& mv)
{
  currentMove = mv;

  applyMove();
  updateOLED();
  publishStatusOnce();

  int stepTime = MAZE_STEP_TIME_MS;
  int slice = 20;  // check every 20ms

  for (int t = 0; t < stepTime; t += slice)
  {
    delay(slice);

    int F = safeDist(frontDist);
    int R = safeDist(rightDist);

    if (F < 6 || R < 4) {
      stopAll();
      return;
    }
  }

  stopAll();
  delay(MAZE_PAUSE_TIME_MS);
}

void runMazeSolver()
{
  motorEnabled = true;
  lastControlMsg = millis();

  // Read sensors
  int R = safeDist(rightDist);
  int F = safeDist(frontDist);
  int B = safeDist(rearDist);

  int targetRight = MAZE_RIGHT_CM;
  int tolerance = 2;   // allowed wall distance error

  // -----------------------
  // Emergency stop
  // -----------------------
  if (F < 6) {
    stopAll();
    currentMove = "STOP";
    updateOLED();
    publishStatusOnce();
    delay(200);
    return;
  }

  // --------------------------------
  // 1. Opening on the right
  // --------------------------------
  if (R > targetRight + 10) {

    currentMove = "RIGHT OPEN";

    mazeStepMove("RIGHT");     // slide into opening
    delay(200);

    mazeStepMove("FORWARD");   // enter corridor
    delay(200);

    return;
  }

  // --------------------------------
  // 2. Wall ahead → turn left
  // --------------------------------
  if (F < MAZE_FRONT_CM) {

    currentMove = "TURN LEFT";

    rotate90Left();
    delay(MAZE_PAUSE_TIME_MS);

    mazeStepMove("FORWARD");
    delay(200);

    return;
  }

  // --------------------------------
  // 3. Smooth wall hugging
  // --------------------------------
  int error = R - targetRight;

  if (error > tolerance) {

    // Too far from wall → move slightly right
    currentMove = "FORWARD-RIGHT";

    mazeStepMove("RIGHT");
    delay(80);

    mazeStepMove("FORWARD");
    delay(150);
  }
  else if (error < -tolerance) {

    // Too close to wall → move slightly left
    currentMove = "FORWARD-LEFT";

    mazeStepMove("LEFT");
    delay(80);

    mazeStepMove("FORWARD");
    delay(150);
  }
  else {

    // Perfect distance
    currentMove = "FORWARD";

    mazeStepMove("FORWARD");
    delay(200);
  }

  updateOLED();
  publishStatusOnce();
}


