// =====================================================
// ================= MOTOR CONTROL =====================
// =====================================================
void stopAll() {
  digitalWrite(FL_IN1, LOW); digitalWrite(FL_IN2, LOW);
  digitalWrite(FR_IN1, LOW); digitalWrite(FR_IN2, LOW);
  digitalWrite(RL_IN1, LOW); digitalWrite(RL_IN2, LOW);
  digitalWrite(RR_IN1, LOW); digitalWrite(RR_IN2, LOW);
}

void setMotorPins(int in1, int in2, int dir) {
  // dir: +1 forward, -1 reverse, 0 stop
  if (dir == 0) { digitalWrite(in1, LOW); digitalWrite(in2, LOW); return; }
  if (dir > 0)  { digitalWrite(in1, HIGH); digitalWrite(in2, LOW); return; }
  digitalWrite(in1, LOW); digitalWrite(in2, HIGH);
}

// =====================================================
