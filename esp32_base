// =====================================================
// ================= MQTT CALLBACK =====================
// =====================================================
void mqttCallback(char* topic, byte* payload, unsigned int length) {
  String t = String(topic);

  String msg;
  msg.reserve(length + 4);
  for (unsigned int i = 0; i < length; i++) msg += (char)payload[i];
  msg.trim();

  if (t == String(topic_control)) {
    StaticJsonDocument<192> doc;
    DeserializationError err = deserializeJson(doc, msg);
    if (err) {
      Serial.print("MQTT CTRL JSON error: ");
      Serial.println(err.c_str());
      return;
    }

    // enable/disable always
    if (doc.containsKey("enable")) {
      motorEnabled = doc["enable"].as<bool>();
      if (!motorEnabled) currentMove = "STOP";
    }

    // MAZE toggle via MQTT: { "maze_toggle": true }
    if (doc.containsKey("maze_toggle")) {
      mazeMode = !mazeMode;
      mazeNextMoveAllowed = 0;
    }

    // ignore move commands while maze is ON
    if (!mazeMode && doc.containsKey("move")) {
      String mv = doc["move"].as<String>();
      mv.trim();
      mv.toUpperCase();

      if (mv == "FORWARD" || mv == "BACKWARD" || mv == "LEFT" || mv == "RIGHT" ||
          mv == "STOP" || mv == "ROTATE_LEFT" || mv == "ROTATE_RIGHT") {
        currentMove = mv;
      } else {
        currentMove = "STOP";
      }
    }

    lastControlMsg = millis();

    if (!mazeMode) applyMove();     // manual applies immediately
    else if (!motorEnabled) stopAll();

    updateOLED();
    publishStatusOnce();

    Serial.print("MQTT CTRL OK: ");
    Serial.println(msg);
  }
}

// =====================================================
// ================= MQTT CONNECT ======================
// =====================================================
void tryConnectMQTT() {
  if (client.connected()) return;

  if (millis() - lastMqttAttempt < 2000) return;
  lastMqttAttempt = millis();

  String clientId = "ESP32C5_ROBOCAR_";
  clientId += String((uint32_t)esp_random(), HEX);

  Serial.print("MQTT -> connecting... ");
  if (client.connect(clientId.c_str(), mqtt_user, mqtt_pass)) {
    Serial.println("OK");
    mqttLine = "MQTT -> done";

    client.subscribe(topic_control);
    publishStatusOnce();
  } else {
    Serial.print("FAIL rc=");
    Serial.println(client.state());
    mqttLine = "MQTT -> fail";
  }
  updateOLED();
}

// =====================================================
// ================= UART SENSORS ======================
// =====================================================
void handleUartLine(String line) {
  line.trim();
  if (!line.startsWith("{")) return;

  StaticJsonDocument<256> doc;
  DeserializationError err = deserializeJson(doc, line);
  if (err) {
    Serial.print("UART JSON error: ");
    Serial.println(err.c_str());
    return;
  }

  rightDist = doc["right"] | -1;
  frontDist = doc["front"] | -1;
  leftDist  = doc["left"]  | -1;
  rearDist  = doc["rear"]  | -1;

  lastJson = line;

  Serial.print("UART OK: ");
  Serial.println(line);

  if (client.connected()) {
    client.publish(topic_sensors, line.c_str(), true);
    Serial.println("MQTT Published");
  }
}

