void handleToggle() {
  motorEnabled = !motorEnabled;
  if (!motorEnabled) currentMove = "STOP";

  lastControlMsg = millis();

  if (!mazeMode) applyMove();
  else if (!motorEnabled) stopAll();

  updateOLED();
  publishStatusOnce();

  server.send(200, "text/plain", "OK");
}

void handleMove() {
  // If maze mode is ON: ignore manual movement commands
  if (mazeMode) {
    server.send(200, "text/plain", "MAZE MODE ON");
    return;
  }

  String uri = server.uri(); // e.g. /move/FORWARD
  String cmd = uri.substring(String("/move/").length());
  cmd.trim();
  cmd.toUpperCase();

  if (cmd != "FORWARD" && cmd != "BACKWARD" && cmd != "LEFT" && cmd != "RIGHT" &&
      cmd != "STOP" && cmd != "ROTATE_LEFT" && cmd != "ROTATE_RIGHT") {
    cmd = "STOP";
  }

  if (!motorEnabled) currentMove = "STOP";
  else currentMove = cmd;

  lastControlMsg = millis();

  applyMove();
  updateOLED();
  publishStatusOnce();

  server.send(200, "text/plain", "OK");
}

